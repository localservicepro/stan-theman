---
permalink: "/contact.html"
prefix: ""
svcPrefix: "services/"
nav: contact
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Contact Stan The Man Cleaning | Free Quotes | Melbourne East</title>
  <meta name="description" content="Contact Stan The Man Cleaning for a free, no-obligation quote. Call or text {{ site.phone }}, email {{ site.email }}, or request a quote online. Servicing Melbourne's Eastern Suburbs." />
  <meta name="theme-color" content="#0F0F0F" />
  <link rel="canonical" href="https://www.stanthemancleaning.com.au/contact.html" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Contact Stan The Man Cleaning" />
  <meta property="og:description" content="Free quotes for window, gutter, pressure, soft and solar panel cleaning across Melbourne's Eastern Suburbs." />
  <meta property="og:url" content="https://www.stanthemancleaning.com.au/contact.html" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="assets/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="assets/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png" />
  <link rel="manifest" href="site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <script>document.documentElement.classList.add('js');</script>
  <link rel="stylesheet" href="css/styles.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Stan The Man Cleaning",
    "url": "https://www.stanthemancleaning.com.au/contact.html",
    "mainEntity": {
      "@type": "CleaningService",
      "name": "Stan The Man Cleaning",
      "telephone": "{{ site.phoneTel }}",
      "email": "{{ site.email }}",
      "url": "https://www.stanthemancleaning.com.au/",
      "address": { "@type": "PostalAddress", "streetAddress": "5 Allinga Place", "addressLocality": "Donvale", "addressRegion": "VIC", "postalCode": "3111", "addressCountry": "AU" },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "07:00", "closes": "18:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "08:00", "closes": "16:00" }
      ],
      "sameAs": [ "{{ site.facebook }}", "{{ site.instagram }}" ]
    }
  }
  </script>
</head>
<body>
  {% include "header.njk" %}

  <main>
    <section class="page-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="index.html">Home</a> / <span>Contact</span></nav>
        <p class="eyebrow" style="margin-top:1rem">Get in touch</p>
        <h1>Get Your Free, No-Obligation Quote</h1>
        <p class="lead muted">Tell us about your property and what you need cleaned. We'll get straight back to you with clear, upfront pricing — no pressure, no obligation.</p>
      </div>
    </section>

    <section class="section" style="padding-top:1rem">
      <div class="wrap split">
        <div class="form-card">
          <h2 style="margin-bottom:.4rem">Request a quote</h2>
          <p class="muted">Fields marked * are required.</p>
          <!-- Field name attributes map to GoHighLevel fields (full_name, phone, email,
               property_address, service_needed, job_notes). The GHL external tracking
               script near the end of the page captures the submission. On submit the
               browser (or js/main.js) navigates to thank-you.html. -->
          <form data-quote-form id="quote-form" name="Website Quote Request" action="thank-you.html" method="GET">
            <div class="field--row">
              <div class="field">
                <label for="name">Name *</label>
                <input id="name" name="full_name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="phone">Phone *</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" required />
              </div>
            </div>
            <div class="field--row">
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" />
              </div>
              <div class="field">
                <label for="property_address">Property address</label>
                <input id="property_address" name="property_address" type="text" autocomplete="street-address" placeholder="e.g. 12 Smith St, Doncaster VIC" />
              </div>
            </div>
            <div class="field">
              <label for="service">Service needed</label>
              <select id="service" name="service_needed">
                <option value="">Select a service…</option>
                <option>Window Cleaning</option>
                <option>Gutter Cleaning</option>
                <option>Pressure Washing</option>
                <option>Soft Washing</option>
                <option>Solar Panel Cleaning</option>
                <option>Multiple services</option>
                <option>Not sure — please advise</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Tell us about the job</label>
              <textarea id="message" name="job_notes" placeholder="Single or double storey, approx. size, anything else we should know…"></textarea>
            </div>
            <input type="hidden" name="source" value="Website – Contact Page" />
            <button class="btn btn--primary btn--lg btn--block" type="submit">Send my request</button>
            <p class="form-status" tabindex="-1" role="status" hidden style="margin-top:1rem;color:var(--orange)"></p>
            <p class="form-note">Prefer to talk? Call or text Stan directly on <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>.</p>
          </form>
        </div>

        <aside>
          <h2>Contact details</h2>
          <ul class="contact-list" style="margin-top:1.2rem">
            <li><span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .5 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.2 1l-2.3 2.1Z"/></svg></span><span><b>Call or text</b><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a></span></li>
            <li><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span><b>Email</b><a href="mailto:{{ site.email }}">{{ site.email }}</a></span></li>
            <li><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.3 7-12a7 7 0 1 0-14 0c0 5.7 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></span><span><b>Based in</b><span>Donvale VIC 3111 — servicing Melbourne's Eastern Suburbs</span></span></li>
            <li><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><b>Hours</b><span>{{ site.hours }}</span></span></li>
          </ul>
          <iframe class="map-embed" title="Map of Stan The Man Cleaning service area" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1576.8121963464225!2d145.18165672054852!3d-37.77540446989378!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa5673e571433289f%3A0x77a2346d468c8447!2sStan%20The%20Man%20Cleaning!5e0!3m2!1sen!2sph!4v1784028483819!5m2!1sen!2sph" width="100%" height="340" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <div class="socials" style="margin-top:1rem">
            <a href="{{ site.facebook }}" aria-label="Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1Z"/></svg></a>
            <a href="{{ site.instagram }}" aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  {% include "footer.njk" %}
  <script src="js/main.js" defer></script>
  <script src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_b39dadcc3417438a8921cebf538d145d"></script>
</body>
</html>
