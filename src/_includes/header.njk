  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="{{ prefix }}index.html" aria-label="Stan The Man Cleaning home">
        <img class="brand__mark" src="{{ prefix }}assets/img/brand-icon.png" alt="" width="38" height="38" decoding="async" />
        <span class="brand__name">Stan The <b>Man</b></span>
      </a>
      <ul class="nav__links">
        <li><a href="{{ prefix }}index.html"{% if nav == "home" %} aria-current="page"{% endif %}>Home</a></li>
        <li class="nav__item--has-menu">
          <button class="nav__submenu-toggle{% if nav == 'services' %} is-current{% endif %}" aria-expanded="false" aria-haspopup="true" aria-controls="services-menu">Services<svg class="nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          <div class="nav__mega" id="services-menu">
{%- for s in site.services %}
            <a class="mega-card" href="{{ svcPrefix }}{{ s.slug }}.html"{% if service == s.slug %} aria-current="page"{% endif %}><span class="mega-card__img"><img src="{{ prefix }}assets/img/{{ s.thumb }}" width="88" height="62" alt="" loading="lazy" decoding="async" /></span><span class="mega-card__body"><span class="mega-card__title">{{ s.title }}</span><span class="mega-card__desc">{{ s.desc }}</span></span></a>
{%- endfor %}
            <a class="mega-card mega-card--cta" href="{{ prefix }}contact.html"><span class="mega-card__body"><span class="mega-card__title">Not sure which service?</span><span class="mega-card__desc">Get a fast, free quote &rarr;</span></span></a>
          </div>
        </li>
        <li><a href="{{ prefix }}about.html"{% if nav == "about" %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="{{ prefix }}contact.html"{% if nav == "contact" %} aria-current="page"{% endif %}>Contact</a></li>
      </ul>
      <div class="nav__cta">
        <a class="nav__phone" href="{{ site.bookingUrl }}" target="_blank" rel="noopener" aria-label="Book online"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M7 2v2H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm12 7v10H5V9h14Z"/></svg>Book Online</a>
        <a class="btn btn--primary" href="{{ prefix }}contact.html">Get a Free Quote</a>
        <button class="nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
      </div>
    </div>
  </header>
